DJANGO_SECRET_KEY=local-dev-secret
DJANGO_DEBUG=true
DATABASE_URL=postgres://octonomy:octonomy@localhost:5432/octonomy
ALLOWED_HOSTS=localhost,127.0.0.1
SERVICE_TOKEN_PEPPER=local-dev-service-token-pepper
OCTONOMY_API_VERSION=3.0.1
LOG_LEVEL=INFO
MAX_BULK_TAGS=200
# Opt-in, superuser-only operator admin at /admin/ (themed with django-unfold).
# Leave UNSET so it defaults to DJANGO_DEBUG — on in local development, and off in
# production unless you deliberately opt in. Uncomment (=true) only if you want the
# admin mounted with DJANGO_DEBUG=false. Bootstrap access with
# `python manage.py createsuperuser`. See docs/operations.md "Admin console".
# OCTONOMY_ADMIN_ENABLED=true
# Session/CSRF cookies are marked Secure automatically when DJANGO_DEBUG=false.
# Uncomment to override for unusual deployments (e.g. TLS terminated at a proxy).
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# Set true ONLY behind a proxy that terminates TLS and sets a trusted X-Forwarded-Proto
# (stripping any client value). Lets the admin's CSRF/secure-cookie logic see HTTPS.
# OCTONOMY_TRUST_FORWARDED_PROTO=true
# Comma-separated, scheme-qualified origins trusted for the admin's CSRF checks. Needed
# only when the browser's admin origin differs from the host Django sees (proxy/CDN).
# CSRF_TRUSTED_ORIGINS=https://admin.example.com
# Namespace rollout control plane (see docs/operations.md). A Django system check
# refuses invalid combinations at boot. Enable order: SCHEMA -> READ -> AUTH ->
# V2_API -> WRITE. Rollback order: V2_API -> AUTH -> WRITE -> READ (SCHEMA stays).
OCTONOMY_NAMESPACE_SCHEMA_ENABLED=true
OCTONOMY_NAMESPACE_READ_ENABLED=true
OCTONOMY_NAMESPACE_AUTH_ENFORCED=true
OCTONOMY_NAMESPACE_V2_API_ENABLED=true
# Kill-switch for namespaced (merchant) writes. Off by default and flips last: v2
# reads are namespace-aware, but persisting namespaced rows is disabled until reads,
# auth, metrics, and the system check are all in place.
OCTONOMY_NAMESPACE_WRITE_ENABLED=false
OCTONOMY_OUTBOX_TRANSPORT=logging
OCTONOMY_WEBHOOK_URL=
OCTONOMY_WEBHOOK_SIGNING_SECRET=
OCTONOMY_WEBHOOK_TIMEOUT_SECONDS=10
OCTONOMY_OUTBOX_MAX_ATTEMPTS=5
OCTONOMY_OUTBOX_RETRY_BASE_SECONDS=30
OCTONOMY_OUTBOX_RETRY_MAX_SECONDS=3600
OCTONOMY_OUTBOX_CLAIM_TIMEOUT_SECONDS=60
