# Octonomy production environment template.
#
# Copy this to a real env file your platform reads (a Kubernetes Secret, a systemd
# EnvironmentFile at /etc/octonomy/octonomy.env, or a Docker --env-file) and fill in the
# blanks. NEVER commit the filled-in copy. Lines are simple KEY=value pairs, compatible
# with Docker --env-file and systemd EnvironmentFile (no quotes or `export` needed).
#
# See docs/deployment.md for the full walkthrough and docs/operations.md for the
# operational runbook (namespace rollout, outbox dispatcher, backups).

# --- Required -------------------------------------------------------------------

# Must be false in production. The container image already defaults this to false;
# set it explicitly on VPS/bare installs.
DJANGO_DEBUG=false

# Generate both with the command below. Do NOT invent a value by hand.
#
# Left EMPTY on purpose. With DEBUG=false the service refuses to boot when either one is
# empty, or is still its local-dev default: exactly "local-dev-secret" for
# DJANGO_SECRET_KEY, exactly "local-dev-service-token-pepper" for SERVICE_TOKEN_PEPPER.
# A half-edited file therefore fails fast instead of running on a publicly-known secret.
#
# Those two tests are the whole of it. The boot guard does NOT judge how good a value you
# supply: DJANGO_SECRET_KEY=thisisthedjangomostsecretkey boots, and so does a
# whitespace-only value such as " ". The generator below is what makes a value
# unpredictable; keeping it out of version control and in your platform's secret store is
# what keeps it secret. Neither is something the service can check for you.
#
# `manage.py check --deploy` adds one narrow signal, for DJANGO_SECRET_KEY only: Django's
# security.W009 warns when the key is under 50 characters, contains fewer than five
# distinct characters, or starts with "django-insecure-". Those three tests and nothing
# else — it measures neither entropy nor secrecy, so a long publicly-known string passes.
# W009 is a warning, so on its own it does not make the command exit nonzero: read the
# output. See docs/deployment.md "Configuration and secrets".
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Keying secret for service-token hashes. Generate it the same way. Changing it
# invalidates every existing service token (rotate all tokens if you change it).
# Beyond the empty/default test above, nothing checks this one at all — security.W009
# covers DJANGO_SECRET_KEY alone and has no SERVICE_TOKEN_PEPPER equivalent.
SERVICE_TOKEN_PEPPER=

# PostgreSQL connection URL. Use a real, reachable PostgreSQL (not SQLite).
DATABASE_URL=postgres://octonomy:CHANGE_ME@db-host:5432/octonomy

# Comma-separated hostnames this instance serves. List your real host(s), and keep
# 127.0.0.1 so container-local health probes (e.g. the Compose healthcheck) are accepted
# — with DEBUG=false Django returns 400 for any Host not listed here. Must NOT be "*".
ALLOWED_HOSTS=api.example.com,127.0.0.1

# Docker Compose ONLY: password for the bundled PostgreSQL "db" service. Uncomment and
# set it to match the password in DATABASE_URL above (for Compose, use host "db":
# DATABASE_URL=postgres://octonomy:<POSTGRES_PASSWORD>@db:5432/octonomy). Kubernetes and
# VPS installs use an external/managed database and ignore this.
# POSTGRES_PASSWORD=CHANGE_ME

# --- Common tuning --------------------------------------------------------------

# Gunicorn worker processes. Rule of thumb: ~2 * CPU cores + 1.
WEB_CONCURRENCY=3
# Log level for the app + gunicorn (JSON to stdout/stderr).
LOG_LEVEL=INFO
# Advertised API version string. LEAVE THIS UNSET: the image already defaults it to the
# version it was built from, so it stays correct across upgrades on its own. Pinning it
# here freezes the advertised version at whatever you copied — nothing in `make
# release-check` validates this file, so the drift would go unnoticed after the next
# release. Only set it to deliberately advertise something other than the built version.
# OCTONOMY_API_VERSION=<version>
# Max tags accepted in a single bulk assignment.
MAX_BULK_TAGS=200

# --- Optional: admin console behind a TLS proxy ---------------------------------
# The admin is OFF in production unless you opt in. Read docs/operations.md
# "Admin console" before enabling it. The app serves its own bundled CSS/JS, so there is
# no separate static-serving step on the container channels; on a venv install run
# `python manage.py collectstatic` before starting (and again on every upgrade).
# OCTONOMY_ADMIN_ENABLED=true
# Only when a proxy terminates TLS AND sets a trusted X-Forwarded-Proto:
# OCTONOMY_TRUST_FORWARDED_PROTO=true
# Scheme-qualified origins trusted for admin CSRF (proxy/CDN in front of the admin):
# CSRF_TRUSTED_ORIGINS=https://api.example.com

# --- Optional: serving under a subpath, or from a CDN ---------------------------
# Only needed when the app is mounted somewhere other than the host root, e.g. at
# https://api.example.com/octonomy/. Set BOTH: STATIC_URL is the path browsers are told
# to fetch assets from, FORCE_SCRIPT_NAME is the prefix every other generated URL carries.
# Setting only the second leaves asset links at the host root, outside the app's own mount
# (a Django system check, octonomy.W003, warns about that). Both are validated at boot.
# OCTONOMY_STATIC_URL=/octonomy/static/
# OCTONOMY_FORCE_SCRIPT_NAME=/octonomy
#
# Or point STATIC_URL at a CDN instead of serving assets from the app. If you do, the CDN
# is a different origin than the admin, so the bundled web fonts need a permissive CORS
# header — set it at the edge, or set WHITENOISE_ALLOW_ALL_ORIGINS back to True.
# OCTONOMY_STATIC_URL=https://cdn.example.com/static/

# --- Namespace rollout (safe defaults; see docs/operations.md before changing) --
# Default posture: schema/read/auth/v2 on, namespaced writes OFF (the kill switch
# flips last). Most deployments leave these as-is. A Django system check refuses to
# boot on an invalid combination.
OCTONOMY_NAMESPACE_SCHEMA_ENABLED=true
OCTONOMY_NAMESPACE_READ_ENABLED=true
OCTONOMY_NAMESPACE_AUTH_ENFORCED=true
OCTONOMY_NAMESPACE_V2_API_ENABLED=true
OCTONOMY_NAMESPACE_WRITE_ENABLED=false

# --- Outbox dispatcher (event delivery) -----------------------------------------
# The dispatcher MUST run as its own scheduled/looping process or events never leave
# the outbox. "logging" just logs them; use "webhook" to POST them to your consumer.
OCTONOMY_OUTBOX_TRANSPORT=logging
# OCTONOMY_OUTBOX_TRANSPORT=webhook
# OCTONOMY_WEBHOOK_URL=https://consumer.internal/octonomy-events
# OCTONOMY_WEBHOOK_SIGNING_SECRET=CHANGE_ME
# OCTONOMY_WEBHOOK_TIMEOUT_SECONDS=10
OCTONOMY_OUTBOX_MAX_ATTEMPTS=5
OCTONOMY_OUTBOX_RETRY_BASE_SECONDS=30
OCTONOMY_OUTBOX_RETRY_MAX_SECONDS=3600
OCTONOMY_OUTBOX_CLAIM_TIMEOUT_SECONDS=60
